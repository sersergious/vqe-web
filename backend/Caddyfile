# Caddy obtains and renews the TLS certificate automatically, provided DOMAIN's
# DNS A record points at this host and ports 80/443 are reachable.
# One upstream now: the app serves both the frontend and the API.
{$DOMAIN} {
	reverse_proxy app:8000 {
		# A 120-point sweep can take ~35s; don't cut it off.
		transport http {
			response_header_timeout 120s
		}
	}
}
