# Credentials guarding the whole app — the UI and the API alike.
# Leave BOTH unset and the app runs open (it logs a warning at startup).
# Generate a password with:
#   python -c "import secrets; print(secrets.token_urlsafe(24))"
AUTH_USERNAME=replace-me
AUTH_PASSWORD=replace-me

# Domain Caddy will request a certificate for. Only used by docker-compose,
# i.e. the self-hosted path — Render handles TLS itself.
DOMAIN=vqe.example.com
